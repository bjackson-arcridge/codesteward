{
  "name": "@arcridge/sundial",
  "version": "0.3.0",
  "description": "Sundial project-local CLI and Decision Record store logic.",
  "license": "Apache-2.0",
  "author": "arcridge",
  "homepage": "https://github.com/bjackson-arcridge/sundial/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/bjackson-arcridge/sundial/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjackson-arcridge/sundial.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "sundial",
    "decision-records",
    "cli",
    "ai",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/main.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "sundial": "dist/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run compile",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "compile-tests": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\" && tsc -p . --outDir out",
    "test:unit": "npm run compile-tests && node --test out/unit/*.test.js",
    "cli": "node dist/main.js"
  }
}
