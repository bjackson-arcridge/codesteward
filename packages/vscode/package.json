{
  "name": "sundial",
  "displayName": "Sundial",
  "description": "Markdown-backed Decision Records and agent skills for AI coding workflows.",
  "version": "0.2.3",
  "publisher": "arcridge",
  "license": "Apache-2.0",
  "homepage": "https://github.com/bjackson-arcridge/sundial/tree/main/packages/vscode#readme",
  "bugs": {
    "url": "https://github.com/bjackson-arcridge/sundial/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjackson-arcridge/sundial.git",
    "directory": "packages/vscode"
  },
  "keywords": [
    "decision-records",
    "ai",
    "agents",
    "claude",
    "codex",
    "ai-coding"
  ],
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "icon": "media/sundial_vscode_icon_slate_lemon_256.png",
  "files": [
    "dist",
    "media",
    "README.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sundial.installCli",
        "title": "Sundial: Install CLI",
        "icon": "$(cloud-download)",
        "enablement": "!sundial.cliAvailable"
      },
      {
        "command": "sundial.bootstrap",
        "title": "Sundial: Bootstrap Decisions",
        "icon": "$(search)",
        "enablement": "sundial.workspaceInitialized"
      },
      {
        "command": "sundial.showDiagnostics",
        "title": "Sundial: Show Diagnostics",
        "icon": "$(output)"
      },
      {
        "command": "sundial.candidates.open",
        "title": "Sundial: Open Candidate Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "sundial.candidates.editSource",
        "title": "Sundial: Edit Candidate Source",
        "icon": "$(edit)"
      },
      {
        "command": "sundial.records.filterByDomain",
        "title": "Sundial: Filter Decision Records by Domain",
        "icon": "$(filter)",
        "enablement": "sundial.workspaceInitialized"
      },
      {
        "command": "sundial.records.clearFilters",
        "title": "Sundial: Clear Decision Record Filters",
        "icon": "$(clear-all)",
        "enablement": "sundial.workspaceInitialized"
      },
      {
        "command": "sundial.records.openPreview",
        "title": "Sundial: Open Decision Record Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "sundial.records.editSource",
        "title": "Sundial: Edit Decision Record Source",
        "icon": "$(edit)"
      },
      {
        "command": "sundial.research.filterByDomain",
        "title": "Sundial: Filter Research by Domain",
        "icon": "$(filter)",
        "enablement": "sundial.workspaceInitialized"
      },
      {
        "command": "sundial.research.clearFilters",
        "title": "Sundial: Clear Research Filters",
        "icon": "$(clear-all)",
        "enablement": "sundial.workspaceInitialized"
      },
      {
        "command": "sundial.research.openPreview",
        "title": "Sundial: Open Research Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "sundial.research.editSource",
        "title": "Sundial: Edit Research Source",
        "icon": "$(edit)"
      },
      {
        "command": "sundial.specs.openBoard",
        "title": "Sundial: Open Specs Board",
        "icon": "$(list-tree)",
        "enablement": "sundial.workspaceInitialized"
      },
      {
        "command": "sundial.specs.openSpec",
        "title": "Sundial: Open Spec",
        "icon": "$(open-preview)"
      },
      {
        "command": "sundial.specs.spawnWorktree",
        "title": "Sundial: Spawn Spec Worktree",
        "icon": "$(repo-forked)",
        "enablement": "sundial.workspaceInitialized"
      },
      {
        "command": "sundial.specs.plan",
        "title": "Sundial: Plan Spec",
        "icon": "$(list-tree)",
        "enablement": "sundial.workspaceInitialized"
      },
      {
        "command": "sundial.specs.implement",
        "title": "Sundial: Implement Spec",
        "icon": "$(replace)",
        "enablement": "sundial.workspaceInitialized"
      },
      {
        "command": "sundial.specs.review",
        "title": "Sundial: Review Spec",
        "icon": "$(eye)",
        "enablement": "sundial.workspaceInitialized"
      },
      {
        "command": "sundial.candidates.accept",
        "title": "Sundial: Accept Candidate",
        "icon": "$(check)"
      },
      {
        "command": "sundial.candidates.reject",
        "title": "Sundial: Reject Candidate",
        "icon": "$(close)"
      },
      {
        "command": "sundial.candidates.retire",
        "title": "Sundial: Retire Candidate",
        "icon": "$(archive)"
      },
      {
        "command": "sundial.candidates.dismiss",
        "title": "Sundial: Dismiss Candidate",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sundial",
          "title": "Sundial",
          "icon": "media/sundial.svg"
        }
      ]
    },
    "views": {
      "sundial": [
        {
          "id": "sundial.welcome",
          "name": "Sundial",
          "type": "webview",
          "when": "sundial.workspaceUninitialized"
        },
        {
          "id": "sundial.records",
          "name": "DECISION RECORDS",
          "type": "webview",
          "when": "sundial.workspaceInitialized"
        },
        {
          "id": "sundial.research",
          "name": "RESEARCH",
          "type": "webview",
          "when": "sundial.workspaceInitialized"
        },
        {
          "id": "sundial.specs",
          "name": "SPECS",
          "type": "webview",
          "when": "sundial.workspaceInitialized"
        },
        {
          "id": "sundial.candidates",
          "name": "CANDIDATES",
          "type": "webview",
          "when": "sundial.workspaceInitialized"
        },
        {
          "id": "sundial.records.rejected",
          "name": "REJECTED DRS",
          "type": "webview",
          "when": "sundial.workspaceInitialized",
          "visibility": "collapsed"
        },
        {
          "id": "sundial.records.retired",
          "name": "RETIRED DRS",
          "type": "webview",
          "when": "sundial.workspaceInitialized",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Sundial",
      "properties": {
        "sundial.cliPath": {
          "type": "string",
          "default": "sundial",
          "description": "Path to the Sundial CLI executable."
        },
        "sundial.comments.renderInlineBubbles": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Render HTML comments in Markdown files as inline chat bubbles."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "sundial.installCli",
          "when": "view == sundial.welcome && !sundial.cliAvailable",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "sundial.installCli",
          "when": "!sundial.cliAvailable"
        },
        {
          "command": "sundial.bootstrap",
          "when": "sundial.workspaceInitialized"
        },
        {
          "command": "sundial.showDiagnostics"
        },
        {
          "command": "sundial.specs.plan",
          "when": "sundial.workspaceInitialized"
        },
        {
          "command": "sundial.specs.implement",
          "when": "sundial.workspaceInitialized"
        },
        {
          "command": "sundial.specs.review",
          "when": "sundial.workspaceInitialized"
        }
      ]
    }
  },
  "scripts": {
    "prepack": "npm run package",
    "vscode:prepublish": "npm run package",
    "check-types:host": "tsc --noEmit",
    "check-types:webview": "tsc --noEmit -p tsconfig.webview.json",
    "check-types": "npm run check-types:host && npm run check-types:webview",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:tsc-webview": "tsc --noEmit --watch -p tsconfig.webview.json",
    "package": "npm run check-types && node esbuild.js --production",
    "package:vsix": "vsce package --no-dependencies",
    "compile-cli": "npm --workspace @arcridge/sundial run compile",
    "compile-tests": "tsc -p . --outDir out",
    "test:unit": "npm run compile-tests && node --test out/unit/*.test.js",
    "watch-tests": "tsc -p . -w --outDir out",
    "prepare-test-workspaces": "node src/test/prepare-workspaces.mjs",
    "prepare-test-runtime": "node ../../scripts/prepare-vscode-test-runtime.mjs",
    "pretest": "npm run compile-cli && npm run compile-tests && npm run compile && npm run prepare-test-workspaces && npm run prepare-test-runtime",
    "test": "vscode-test"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@vscode/codicons": "^0.0.45",
    "lit": "^3.3.2"
  }
}
